# Valores que debe suministrar el operador. No contiene secretos utilizables.
# Obligatoria: local, testing o deployment.
CHILITO_ENV=local
# Solo perfil local; en despliegue detiene el arranque.
CHILITO_DEBUG=0
CHILITO_DJANGO_KEY=
CHILITO_SUPPORT_KEY=
CHILITO_DB_HOST=127.0.0.1
CHILITO_DB_PORT=5432
CHILITO_DB_NAME=chilito_integracion_sinteticos
CHILITO_DB_USER=chilito_pkg_runtime
CHILITO_DB_PASSWORD=
# Local: disable. Despliegue: verify-full (cualquier otro valor detiene el arranque).
CHILITO_DB_SSLMODE=disable
# 1 permite registrar cuentas nuevas. En despliegue, sin definir, queda cerrado.
CHILITO_REGISTRATION_ENABLED=1
CHILITO_ORIGIN=http://localhost:8780
CHILITO_MAILBOX=/tmp/el-chilito-integracion-correo-pruebas
# Archivo creado con tools/configurar_correo.py, fuera del repositorio.
# CHILITO_SMTP_CONFIG=/home/usuario/.config/el-chilito/smtp.json
CHILITO_SMTP_ENABLED=0
CHILITO_SMTP_HOST=
CHILITO_SMTP_PORT=587
CHILITO_SMTP_USER=
CHILITO_SMTP_PASSWORD=
# restricted: destinatarios explícitos; any-valid: registro público confirmado por el propietario
CHILITO_SMTP_RECIPIENT_MODE=restricted
CHILITO_SMTP_ALLOWED_RECIPIENTS=
CHILITO_FROM_EMAIL=El Chilito <no-reply@example.test>
# Contacto que se muestra a quien perdió sus métodos de segundo factor.
CHILITO_CONTACTO_SOPORTE=
# Solo despliegue.
# Clave Fernet para cifrar TOTP y códigos de recuperación. Perderla invalida esos métodos.
# CHILITO_MFA_KEY=
# CHILITO_ALLOWED_HOSTS=
# CHILITO_BEHIND_PROXY=1
# CHILITO_TRUSTED_PROXY_COUNT=1
